datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  name         String?
  passwordHash String

  restaurants  Restaurant[]
}

model Restaurant {
  id        Int    @id @default(autoincrement())
  name      String
  address   String

  ownerId   Int
  owner     User   @relation(fields: [ownerId], references: [id])
}
